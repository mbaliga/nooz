# Local-dev template for release signing (app/build.gradle.kts, signingConfigs.release).
# Copy to `keystore.properties` (gitignored — never commit the real file) and
# fill in the real values to build a signed release AAB/APK on your own
# machine. CI never uses this file; it decodes the same key from GitHub
# Actions secrets instead (see .github/workflows/release.yml).
storeFile=/absolute/path/to/nooz-release.keystore
storePassword=
keyAlias=nooz-release
keyPassword=
