    <string name="tour_loom_name">O Tear</string>
    <string name="tour_loom_body">O que as suas fontes lhe enviaram de facto, tecido contra o que leu de facto. Puxe para baixo na sua banca, ou toque na barra colorida por cima das notícias.</string>
    <string name="tour_flash_name">Nooz Flash</string>
    <string name="tour_flash_body">As manchetes do dia reduzidas a uma linha cada, com um caminho de volta ao artigo completo. Desligado até o ligar, nas Definições.</string>
    <string name="tour_cast_name">Nooz Cast</string>
    <string name="tour_cast_body">Um artigo lido em voz alta por uma voz que corre no seu telemóvel e não num servidor. Também nas Definições; pergunta antes de descarregar seja o que for.</string>
    <string name="tour_clippings_name">Recortes</string>
    <string name="tour_clippings_body">Toque no marcador enquanto lê para guardar um artigo. Os Recortes guardam-nos como pedaços rasgados do jornal.</string>
    <string name="tour_history_name">Hoje na história</string>
    <string name="tour_history_body">Uma coluna curta e datada por cima das notícias do dia, vinda do «neste dia» da própria Wikipédia. Desligada até a ligar.</string>
