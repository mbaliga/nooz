    <string name="tour_loom_body">Lo que tus fuentes te enviaron realmente, tejido contra lo que de verdad leíste. Tira hacia abajo en tu quiosco, o toca la barra de colores sobre las noticias.</string>
    <string name="tour_flash_name">Nooz Flash</string>
