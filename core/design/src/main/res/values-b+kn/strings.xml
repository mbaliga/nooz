    <string name="onboarding_mode_explainer">“ನಿಯಂತ್ರಣಗಳನ್ನು ತೋರಿಸು” ಆಯ್ಕೆಯಲ್ಲಿ ಹಿಂದಿರುಗುವ ಗುಂಡಿ ಮತ್ತು ಸಾಧನಪಟ್ಟಿ ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುತ್ತವೆ. “ಪೂರ್ಣ ಪುಟ” ಅವನ್ನು ಮರೆಮಾಡಿ ಪುಟವನ್ನು ಸರಳವಾಗಿ ಇಡುತ್ತದೆ; ಹಿಂದಿರುಗಲು ಬಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ. ಇದನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಿಸಬಹುದು.</string>
    <string name="tour_title">ಒಳಗೆ ಏನಿದೆ</string>
    <string name="tour_loom_name">ಲೂಮ್</string>
    <string name="tour_loom_body">ನಿಮ್ಮ ಮೂಲಗಳು ನಿಜವಾಗಿ ಏನು ಕಳುಹಿಸಿದವು, ನೀವು ನಿಜವಾಗಿ ಏನು ಓದಿದಿರಿ — ಎರಡನ್ನೂ ಒಟ್ಟಿಗೆ ನೇಯ್ದಂತೆ. ನಿಮ್ಮ ಸ್ಟ್ಯಾಂಡ್ ಮೇಲೆ ಕೆಳಕ್ಕೆ ಎಳೆಯಿರಿ, ಅಥವಾ ಸುದ್ದಿಗಳ ಮೇಲಿನ ಬಣ್ಣದ ಪಟ್ಟಿಯನ್ನು ಸ್ಪರ್ಶಿಸಿ.</string>
    <string name="tour_flash_name">ನೂಜ಼್ ಫ್ಲ್ಯಾಶ್</string>
    <string name="tour_flash_body">ದಿನದ ಮುಖ್ಯಾಂಶಗಳು ತಲಾ ಒಂದೇ ಸಾಲಿನಲ್ಲಿ, ಪೂರ್ಣ ಲೇಖನಕ್ಕೆ ಮರಳುವ ದಾರಿಯೊಂದಿಗೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಚಾಲೂ ಮಾಡುವವರೆಗೆ ಇದು ಆಫ್ ಆಗಿರುತ್ತದೆ.</string>
    <string name="tour_cast_name">ನೂಜ಼್ ಕಾಸ್ಟ್</string>
    <string name="tour_cast_body">ಸರ್ವರ್‌ನಲ್ಲಲ್ಲ, ನಿಮ್ಮ ಫೋನಿನಲ್ಲೇ ನಡೆಯುವ ಧ್ವನಿಯಲ್ಲಿ ಲೇಖನವನ್ನು ಓದಿ ಹೇಳಲಾಗುತ್ತದೆ. ಇದೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿದೆ; ಏನನ್ನಾದರೂ ಇಳಿಸುವ ಮೊದಲು ಕೇಳುತ್ತದೆ.</string>
    <string name="tour_clippings_name">ಕತ್ತರಿಸಿದವು</string>
    <string name="tour_clippings_body">ಓದುತ್ತಿರುವಾಗ ಬುಕ್‌ಮಾರ್ಕ್ ಸ್ಪರ್ಶಿಸಿ ಒಂದು ಲೇಖನವನ್ನು ಇಟ್ಟುಕೊಳ್ಳಿ. ಕತ್ತರಿಸಿದವು ಅವನ್ನು ಪತ್ರಿಕೆಯ ಹರಿದ ತುಣುಕುಗಳಂತೆ ಇರಿಸುತ್ತವೆ.</string>
    <string name="tour_history_name">ಇಂದು ಇತಿಹಾಸದಲ್ಲಿ</string>
    <string name="tour_history_body">ದಿನದ ಸುದ್ದಿಗಳ ಮೇಲೆ ಒಂದು ಚಿಕ್ಕ ದಿನಾಂಕವಾರು ಅಂಕಣ, ವಿಕಿಪೀಡಿಯದ ಸ್ವಂತ “ಇಂದಿನ ದಿನ”ದಿಂದ. ಚಾಲೂ ಮಾಡುವವರೆಗೆ ಆಫ್.</string>
    <string name="tour_footer">ನೀವು ಕೇಳದ ಯಾವುದಕ್ಕೂ ಇಲ್ಲಿಂದ ಏನೂ ತಲುಪುವುದಿಲ್ಲ. ಮೇಲಿನ ಮೂರೂ ಸ್ವಿಚ್‌ಗಳು ನೀವು ಚಾಲೂ ಮಾಡುವವರೆಗೆ ಆಫ್ ಆಗಿಯೇ ಇರುತ್ತವೆ.</string>
