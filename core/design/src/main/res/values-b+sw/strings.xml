    <string name="tour_flash_name">Nooz Flash</string>
    <string name="tour_flash_body">Vichwa vya habari vya siku vikipunguzwa hadi mstari mmoja kila kimoja, na njia ya kurudi kwenye makala kamili. Kimezimwa hadi ukiwashe, katika Mipangilio.</string>
