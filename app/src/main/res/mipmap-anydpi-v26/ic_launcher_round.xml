<?xml version="1.0" encoding="utf-8"?>
<!--
  Same layers as ic_launcher.xml. An adaptive icon is already masked to
  whatever shape the launcher uses, circle included, so the round variant
  needs no separate artwork — it exists only so launchers that ask for
  `roundIcon` by name get the adaptive icon rather than falling back to the
  flat legacy PNG.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
