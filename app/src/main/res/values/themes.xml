<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Activity-level theme used before Compose takes over (window background,
      status bar). Only the first frame is drawn from here; every frame after
      it comes from the Compose token contract in :core:design.

      Light platform parent by day, with values-night/ swapping in the dark one,
      so the first frame matches ThemeMode.SYSTEM (the default since D34). There
      is deliberately no "DayNight" parent here: that exists in AppCompat and
      Material Components, not in the platform's own android:Theme.Material
      family, and naming one fails resource linking outright. Two qualified
      resources do the same job with styles that actually exist.
    -->
    <style name="Theme.River" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/river_window_background</item>
        <item name="android:statusBarColor">@color/river_window_background</item>
        <item name="android:navigationBarColor">@color/river_window_background</item>
        <!-- Light surface by day: the bars need dark icons drawn on them. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!--
          Never let the OS invert this app for us. Nooz ships its own three
          tints plus a follow-the-phone mode, so an OEM force-dark pass (One UI
          offers exactly this for apps it believes lack a dark theme) has
          nothing to add and a great deal to break: it re-colours what it can
          reach and leaves Compose's own drawing alone, which lands as
          near-black text on a darkened field. That is the Galaxy S26+ report.
        -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
