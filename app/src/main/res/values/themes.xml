<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Activity-level theme used before Compose takes over (window background,
      status bar). Dark-first; the window background is the raised surface
      (#121212-class), never pure black. Mirrors the design token contract.
    -->
    <style name="Theme.River" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/river_window_background</item>
        <item name="android:statusBarColor">@color/river_window_background</item>
        <item name="android:navigationBarColor">@color/river_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
