<?xml version="1.0" encoding="utf-8"?>
<!-- Every Nooz widget below its template's minimum size: one tappable summary line, never squeezed controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding"
    android:paddingTop="@dimen/widget_tiny_padding_vertical"
    android:paddingEnd="@dimen/widget_padding"
    android:paddingBottom="@dimen/widget_tiny_padding_vertical">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_ink_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp" />
</LinearLayout>
