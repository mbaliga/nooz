<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout: the widget's shape for the picker, with no data in it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/tour_history_name"
        android:textColor="@color/widget_ink"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_skeleton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@color/widget_skeleton_strong" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="@color/widget_skeleton" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_skeleton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@color/widget_skeleton_strong" />

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="@color/widget_skeleton" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_skeleton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@color/widget_skeleton_strong" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="@color/widget_skeleton" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
