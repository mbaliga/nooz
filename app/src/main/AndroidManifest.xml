<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The user's own fetches to their own chosen sources. No other egress. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      No push notifications in v1 (brief §3): no C2DM/FCM, no POST_NOTIFICATIONS.
      No telemetry, no analytics, no crash reporters that transmit.
    -->

    <application
        android:name=".RiverApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.River">

        <!--
          On-demand WorkManager initialization: RiverApplication builds
          WorkManager's Configuration itself (with RiverWorkerFactory, our
          manual-DI worker factory) in onCreate(). The default ContentProvider-
          based auto-init must be removed or it races the app's own DI
          container construction — see RiverApplication's kdoc.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.River">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
