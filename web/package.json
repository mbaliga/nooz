{
  "name": "nooz-web-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Static Nooz web reader plus two serverless helpers: /api/feed (CORS proxy for RSS/Atom) and /api/article (full-article extraction).",
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.5"
  },
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node --test tests/browser/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
